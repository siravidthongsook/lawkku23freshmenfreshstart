SESSION_COOKIE_NAME=lawkku_freshstart23_session
# base64 32-byte key (AES-256-GCM) — test-only, generated for this harness.
TEMP_PW_ENC_KEY=wZ1FWDSiM6T+OVsJNKCf1c69JOgMhV/YZzni9B1MZAg=
STORAGE_DIR=./.storage-test
COOKIE_SECURE=false
