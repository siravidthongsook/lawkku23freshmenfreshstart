# Observability stack secrets. Copy to .env.observability (gitignored) and fill in real values.
# Used by:  docker compose -p eticket_obs -f docker-compose.observability.yml --env-file .env.observability up -d

# postgres-exporter DSN. Use a LEAST-PRIVILEGE monitoring role, NOT the app owner.
# Reaches the app DB by service name over the shared eticket_default network (db:5432).
# Suggested role setup (run once against the app DB):
#   CREATE ROLE eticket_monitor LOGIN PASSWORD '...';
#   GRANT pg_monitor TO eticket_monitor;   -- read-only stats access, no table data
# sslmode=disable is fine for in-network traffic on the shared docker network.
DATA_SOURCE_NAME=postgresql://eticket_monitor:CHANGE_ME@db:5432/lawkku_freshstart23?sslmode=disable

# Grafana initial admin password (admin user). Change on first login or front with SSO later.
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME

# Discord webhook for Grafana alert contact point (observability/grafana/.../contactpoints.yml).
# Same webhook also set as the GitHub Actions secret DISCORD_WEBHOOK_URL for deploy/rollback alerts.
DISCORD_WEBHOOK_URL=CHANGE_ME

# Grafana → audit_logs Postgres datasource. MUST be the read-only role on the PII-stripped VIEW,
# NEVER the app DATABASE_URL owner (preserves the append-only invariant — see audit_safe_view.sql).
#   CREATE ROLE grafana_ro LOGIN PASSWORD '...';  -- then GRANT SELECT on audit_logs_safe only
GRAFANA_PG_USER=grafana_ro
GRAFANA_PG_PASSWORD=CHANGE_ME
GRAFANA_PG_DATABASE=lawkku_freshstart23
