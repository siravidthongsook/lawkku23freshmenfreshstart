{
  "name": "lawkku-freshstart23-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,magenta \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "dev:backend": "tsx watch --env-file-if-exists=.env --import ./src/lib/otel.ts src/server.ts",
    "dev:frontend": "pnpm -C web dev",
    "start": "tsx --env-file-if-exists=.env --import ./src/lib/otel.ts src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "load:users": "tsx --env-file-if-exists=.env src/db/load-users.ts",
    "db:backfill-qr": "tsx --env-file-if-exists=.env src/db/backfill-qr-token-enc.ts",
    "reconcile:points": "tsx --env-file-if-exists=.env src/db/reconcile-points.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.4.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.52.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.55.0",
    "@opentelemetry/sdk-node": "^0.55.0",
    "argon2": "^0.41.1",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.14",
    "papaparse": "^5.4.1",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^22.10.2",
    "@types/papaparse": "^5.3.15",
    "@types/pg": "^8.11.10",
    "concurrently": "^10.0.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.28.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  }
}
