# Copy to .env for local dev. docker-compose injects its own values.
NODE_ENV=development
PORT=33491
DATABASE_URL=postgres://lawkku_freshstart23:lawkku_freshstart23@localhost:5432/lawkku_freshstart23
SESSION_COOKIE_NAME=lawkku_freshstart23_session
# base64-encoded 32-byte key (AES-256-GCM) for encrypting temp passwords at rest
TEMP_PW_ENC_KEY=0000000000000000000000000000000000000000000==
STORAGE_DIR=./.storage
# set true behind HTTPS (prod). false for local http dev.
COOKIE_SECURE=false

# Observability — default ON; set "false" to disable. App boots even if collector unreachable.
OTEL_ENABLED=true
METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318

# Seed admin (src/db/seed.ts) — used only by the seed script, not validated in src/env.ts.
SEED_ADMIN_EMAIL=admin@lawkku-freshstart23.local
SEED_ADMIN_NAME=System Admin
SEED_ADMIN_PASSWORD=ChangeMe123!
