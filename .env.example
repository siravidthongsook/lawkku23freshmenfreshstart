# Copy to .env for local dev. docker-compose injects its own values.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://eticket:eticket@localhost:5432/eticket
SESSION_COOKIE_NAME=eticket_session
# base64-encoded 32-byte key (AES-256-GCM) for encrypting temp passwords at rest
TEMP_PW_ENC_KEY=0000000000000000000000000000000000000000000==
STORAGE_DIR=./.storage
# set true behind HTTPS (prod). false for local http dev.
COOKIE_SECURE=false
