# Prod compose secrets — copy to .env on the deploy box (gitignored). Never commit real values.
# docker-compose.yml reads these via ${VAR} interpolation.

# Postgres creds (db service init + healthcheck). DATABASE_URL below must match these.
POSTGRES_USER=lawkku_freshstart23
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lawkku_freshstart23

# API connection string — same user/password/db as above, host is the compose service name `db`.
DATABASE_URL=postgres://lawkku_freshstart23:change-me@db:5432/lawkku_freshstart23

# 32-byte base64 AES-256-GCM key for temp-password encryption. Generate: openssl rand -base64 32
TEMP_PW_ENC_KEY=change-me
