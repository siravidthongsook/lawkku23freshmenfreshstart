// Grafana Alloy config (River/HCL syntax) for the eticket box.
// Job: discover Docker containers, tail stdout of the api AND web containers (N5),
// push to Loki (loki:3100). OTLP-via-Alloy is OPTIONAL and kept commented — the app
// exports traces DIRECTLY to tempo:4318, so Alloy is logs-only by default here.

// --- Discover all running containers via the mounted docker.sock (ro) ---
discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

// Keep only the api + web containers, and derive clean Loki labels from container metadata.
// N5: we tail BOTH api and web stdout. Match on compose service label so a -p project rename
// or container-name suffix doesn't break the filter.
discovery.relabel "app_containers" {
	targets = discovery.docker.containers.targets

	// Keep containers whose compose service is api or web.
	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		regex         = "(api|web)"
		action        = "keep"
	}

	// service label = compose service name (api / web) for tidy Loki queries.
	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service"
	}

	// container label = full container name (strip leading slash).
	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}

	// static job label for all app logs.
	rule {
		target_label = "job"
		replacement  = "eticket-app"
	}
}

// --- Tail container stdout/stderr from the Docker engine and ship to Loki ---
loki.source.docker "app_logs" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.app_containers.output
	labels     = { platform = "docker" }
	forward_to = [loki.write.default.receiver]
}

// --- Loki write endpoint ---
loki.write "default" {
	endpoint {
		// service name + container port over the shared eticket_default network.
		url = "http://loki:3100/loki/api/v1/push"
	}
}

// --- OPTIONAL: OTLP through Alloy (DISABLED by default) ---
// The app exports traces straight to tempo:4318, so routing OTLP via Alloy is NOT needed.
// Uncomment only if you decide to centralize/relabel traces through Alloy later, and then
// point the app's OTEL_EXPORTER_OTLP_ENDPOINT at alloy:4318 instead of tempo:4318.
//
// otelcol.receiver.otlp "default" {
//   http { endpoint = "0.0.0.0:4318" }
//   output { traces = [otelcol.exporter.otlp.tempo.input] }
// }
// otelcol.exporter.otlp "tempo" {
//   client { endpoint = "tempo:4317" }
// }
